{
  "name": "notes",
  "version": "1.5.0",
  "description": "Anthology of Snippets",
  "keywords": [
    "notes"
  ],
  "homepage": "https://github.com/25prabhu10/notes#readme",
  "bugs": {
    "url": "https://github.com/25prabhu10/notes/issues"
  },
  "license": "MIT",
  "author": "Prabhu K Hiremath",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/25prabhu10/notes.git"
  },
  "type": "module",
  "scripts": {
    "build": "vitepress build docs",
    "clean:docs": "cd docs && rm -rf Collection Concepts Languages Non-Sorted",
    "deploy": "npm run fetch && npm run build && node ./utils/deploy.ts",
    "dev": "npm run fetch && npm run docs:dev",
    "docs:dev": "vitepress dev docs --host",
    "preview": "vitepress preview docs",
    "fetch": "sh utils/bash/sync.sh",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "pnpm run lint:vue && pnpm run lint:js && pnpm run lint:md",
    "lint:md": "markdownlint-cli2 './docs/**/*.md' '#./docs/README.md' '#./docs/about.md'",
    "lint:js": "oxlint --type-aware --type-check --deny-warnings",
    "lint:text": "textlint -f pretty-error './docs/**/*.md'",
    "lint:vue": "vue-tsc --noEmit",
    "lint:fix": "pnpm run lint:js --fix"
  },
  "devDependencies": {
    "@textlint-rule/textlint-rule-no-unmatched-pair": "^2.0.4",
    "@types/node": "^25.1.0",
    "lefthook": "^2.0.16",
    "markdown-it-mathjax3": "^4.3.2",
    "markdownlint-cli2": "^0.20.0",
    "oxc-minify": "^0.111.0",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.42.0",
    "oxlint-tsgolint": "^0.11.3",
    "textlint": "^15.5.1",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-common-misspellings": "^1.0.1",
    "textlint-rule-diacritics": "^2.1.4",
    "textlint-rule-en-capitalization": "^2.0.3",
    "textlint-rule-spelling": "^0.3.0",
    "textlint-rule-terminology": "^5.2.16",
    "textlint-rule-write-good": "^2.0.0",
    "typescript": "~5.9.3",
    "vitepress": "2.0.0-alpha.15",
    "vue": "^3.5.27",
    "vue-tsc": "^3.2.4"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "vitepress>vite": "npm:vite@8.0.0-beta.10"
    },
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
