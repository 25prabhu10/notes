{
  "compilerOptions": {
    "outDir": "build",
    "rootDir": ".",
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["utils/**/*", "docs/**/*"],
  "exclude": ["node_modules", "dev", "dist", ".vitepress/cache"]
}
